{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "clipped",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_flags": ["nodejs_als"],
	"compatibility_date": "2026-09-04",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"secrets": {
		"required": ["SESSION_SIGNING_KEY"]
	},
	"ratelimits": [
		{
			"name": "PAD_UNLOCK_RATE_LIMITER",
			"namespace_id": "904001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "CLIENT_UNLOCK_RATE_LIMITER",
			"namespace_id": "904002",
			"simple": {
				"limit": 30,
				"period": 60
			}
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "clipped-db",
			"database_id": "3b627a06-e433-4412-9a54-82f5eadb2aee",
			"migrations_dir": "./drizzle",
			"migrations_pattern": "./drizzle/*/migration.sql"
		}
	]
}
