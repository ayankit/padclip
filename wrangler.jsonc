{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "padclip",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_flags": ["nodejs_als"],
	"compatibility_date": "2026-09-04",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"secrets": {
		"required": ["SESSION_SIGNING_KEY"]
	},
	"ratelimits": [
		{
			"name": "PAD_UNLOCK_RATE_LIMITER",
			"namespace_id": "904001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "CLIENT_UNLOCK_RATE_LIMITER",
			"namespace_id": "904002",
			"simple": {
				"limit": 30,
				"period": 60
			}
		},
		{
			"name": "CLIENT_CREATE_RATE_LIMITER",
			"namespace_id": "904003",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			"name": "GLOBAL_CREATE_RATE_LIMITER",
			"namespace_id": "904004",
			"simple": {
				"limit": 60,
				"period": 60
			}
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "padclip",
			"database_id": "f0a7c49b-3d3e-4fd5-8a87-f111150e937c",
			"migrations_dir": "./drizzle",
			"migrations_pattern": "./drizzle/*/migration.sql"
		}
	]
}
