{
	"name": "padclip",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types --check && vite build && pnpm build:cleanup",
		"build:cleanup": "wrangler deploy --dry-run --config wrangler.cleanup.jsonc --outdir .wrangler/cleanup-build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"test": "node --test tests/*.test.mjs",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"dev:cleanup": "wrangler dev --config wrangler.cleanup.jsonc --test-scheduled",
		"deploy:cleanup": "wrangler deploy --config wrangler.cleanup.jsonc"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"drizzle-kit": "1.0.0-rc.4",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4.129.0"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.0",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/language-data": "^6.5.2",
		"@codemirror/view": "^6.43.11",
		"codemirror": "^6.0.2",
		"drizzle-orm": "1.0.0-rc.4"
	}
}
